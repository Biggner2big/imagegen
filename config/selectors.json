{
  "_comment": "Fallback chains. Each entry is tried in order until one matches a visible+enabled element. Entries may use the :has-text(\"...\") pseudo helper, which is resolved in page context (it is not real CSS).",
  "_lastVerified": "unverified against live Gemini - run Settings > Diagnostics",
  "promptEditor": [
    "div.ql-editor[contenteditable=\"true\"]",
    "rich-textarea div[contenteditable=\"true\"]",
    "div[contenteditable=\"true\"][role=\"textbox\"]",
    "textarea[aria-label*=\"prompt\" i]"
  ],
  "sendButton": [
    "button.send-button:not([disabled])",
    "button[aria-label*=\"Send message\" i]:not([disabled])",
    "button[aria-label*=\"Send\" i]:not([disabled])",
    "button[aria-label*=\"Submit\" i]:not([disabled])",
    "button[type=\"submit\"]:not([disabled])"
  ],
  "uploadButton": [
    "button[aria-label*=\"Upload\" i]",
    "button[aria-label*=\"Add file\" i]",
    "button[aria-label*=\"Add image\" i]",
    "button[aria-label*=\"Attach\" i]",
    "gem-icon-button[aria-label*=\"Upload\" i]",
    "button[data-test-id=\"upload-button\"]"
  ],
  "fileInput": [
    "input[type=\"file\"][accept*=\"image\"]",
    "input[type=\"file\"]"
  ],
  "uploadedAttachment": [
    "div[class*=\"attachment\"] img",
    "img[src^=\"blob:\"]",
    "button[aria-label*=\"Remove file\" i]",
    "button[aria-label*=\"Remove image\" i]"
  ],
  "generatedImage": [
    "message-content img[src*=\"googleusercontent.com\"]",
    "model-response img[src*=\"googleusercontent.com\"]",
    "img[src*=\"lh3.googleusercontent.com\"]",
    "img[src^=\"blob:\"][width]:not([width=\"0\"])",
    "img[src^=\"data:image\"]"
  ],
  "downloadButton": [
    "button[aria-label*=\"Download\" i]",
    "button[aria-label*=\"Save image\" i]",
    "download-generated-image-button"
  ],
  "generatingIndicator": [
    "[data-test-id=\"loading-indicator\"]",
    "mat-progress-bar",
    "div[role=\"progressbar\"]",
    "div[class*=\"loading\"]"
  ],
  "errorCard": [
    "[role=\"alert\"]:not(:has(img))",
    "div[class*=\"error\"]",
    "div[class*=\"Error\"]"
  ],
  "usageLimitBanner": [
    "[role=\"alert\"]:has-text(\"limit\")",
    "[role=\"alert\"]:has-text(\"try again later\")",
    "[role=\"alert\"]:has-text(\"too many requests\")"
  ],
  "captchaIndicator": [
    "iframe[src*=\"recaptcha\"]",
    "iframe[src*=\"challenges.cloudflare.com\"]",
    "div[class*=\"captcha\"]"
  ],
  "signInButton": [
    "a[href*=\"accounts.google.com\"]",
    "button:has-text(\"Sign in\")",
    "a:has-text(\"Sign in\")"
  ],
  "loginIndicator": [
    "div.ql-editor[contenteditable=\"true\"]",
    "rich-textarea",
    "button[aria-label*=\"Send message\" i]"
  ],
  "responseContainer": [
    "message-content",
    "model-response",
    "div[class*=\"response-container\"]"
  ],
  "newChatButton": [
    "a[href=\"/app\"]:not([aria-current=\"page\"])",
    "button[aria-label*=\"New chat\" i]",
    "[data-test-id=\"new-chat-button\"]"
  ]
}
